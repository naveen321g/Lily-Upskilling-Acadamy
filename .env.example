# Copy this file to .env and fill in real values. Never commit the real .env.

# Supabase (server-side)
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase (client-side — must be prefixed VITE_ to reach the browser bundle)
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Lovable AI Gateway — used by admin.server.ts::generateQuestionsWithAi and
# assessment.server.ts::evaluateWithAi. Optional: both fall back gracefully
# (evaluateWithAi never throws) if this is missing, but AI features degrade.
LOVABLE_API_KEY=

# Groq — used by the AI Interview feature (src/lib/interview-engine)
BUSTLER_GROQ_API_KEY=

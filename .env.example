# Copy this file to .env and fill in real values. Never commit the real .env.

# PostgreSQL connection (required). The database is created by `npm run db:setup`
# if it doesn't exist yet. Use a user that can create roles (e.g. `postgres`).
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/lua

# Public URL of the app, used in password-reset email links.
# Optional: defaults to the URL the request came in on.
APP_URL=

# Where uploaded certificate files are stored. Optional: defaults to ./.local-storage
LOCAL_STORAGE_DIR=

# Secret for signing file-download links. Optional: a random one is generated
# on each server start (links are short-lived, so that's fine for one server).
STORAGE_SIGNING_SECRET=

# SMTP for password-reset emails. Optional: if SMTP_HOST is empty, the reset
# link is printed to the server console instead of being emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Groq — powers every AI feature: the AI Interview (src/lib/interview-engine),
# admin question generation and post-assessment feedback (src/lib/ai.server.ts).
# Optional: without it, question generation shows an error, feedback falls back
# to a templated summary, and the interview can't start.
BUSTLER_GROQ_API_KEY=
